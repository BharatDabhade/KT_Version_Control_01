        <au_script><![CDATA[import java.io.File;
import java.security.PrivateKey;
import java.security.PublicKey;

import com.adeptia.indigo.services.ServiceException;
import com.nimbusds.jose.jwk.JWK;
import com.nimbusds.jose.jwk.JWKSet;

import io.jsonwebtoken.SignatureAlgorithm;

CommonJwtUtil obj = new CommonJwtUtil();

String workatoKid = context.get("workatoKid");
String privateKeyString = context.get("privateKeyString");
String issuer = context.get("issuer");
int expiryMinutes = Integer.parseInt(context.get("expiryMinutes")+"");
String jwtkey ="";

try {

	PrivateKey privateKey = obj.getPrivateKey(privateKeyString);

	jwtkey = obj.createJwt(privateKey, SignatureAlgorithm.RS256, workatoKid, issuer, expiryMinutes);

	context.put("headerjwtkey",jwtkey);

} catch (Exception e) {
	String errorMessage = e.getMessage();
	context.put("errorMessage",errorMessage);
	throw new ServiceException(e);

}]]></au_script>
